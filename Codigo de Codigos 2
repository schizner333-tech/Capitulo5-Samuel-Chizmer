#include <iostream>

using namespace std;

int main() {
    double limite, base;

    // Leer limite, base
    cout << "Ingrese el limite: ";
    cin >> limite;
    cout << "Ingrese la base: ";
    cin >> base;

    // ¿limite <= 0 o base <= 0?
    if (limite <= 0 || base <= 0) {
        // Mostrar error -> Fin
        cout << "Error: El limite y la base deben ser mayores a 0." << endl;
        return 0;
    }

    // potencia = 1
    double potencia = 1;

    // ¿potencia <= limite?
    while (potencia <= limite) {
        // Mostrar potencia
        cout << "Potencia: " << potencia << endl;

        // potencia = potencia * base
        potencia = potencia * base;
    }

    return 0;
}


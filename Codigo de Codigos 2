#include <iostream>

using namespace std;

int main() {
    int n;

    // Leer n
    cout << "Ingrese la cantidad de numeros (n): ";
    cin >> n;

    // ¿n <= 0?
    if (n <= 0) {
        // Mostrar error -> Fin
        cout << "Error: La cantidad de numeros debe ser mayor a 0." << endl;
        return 0;
    }

    // Leer primer numero
    double num;
    cout << "Ingrese el numero 1: ";
    cin >> num;

    // mayor = num, menor = num, suma = num, i = 2
    double mayor = num;
    double menor = num;
    double suma = num;
    int i = 2;

    // ¿i <= n?
    while (i <= n) {
        // Leer num
        cout << "Ingrese el numero " << i << ": ";
        cin >> num;

        // suma = suma + num
        suma = suma + num;

        // ¿num > mayor?
        if (num > mayor) {
            mayor = num;
        } 
        // ¿num < menor?
        else if (num < menor) {
            menor = num;
        }

        // i = i + 1
        i = i + 1;
    }

    // media = suma / n
    double media = suma / n;

    // Mostrar mayor, menor, media -> Fin
    cout << "\n--- Resultados ---" << endl;
    cout << "Mayor: " << mayor << endl;
    cout << "Menor: " << menor << endl;
    cout << "Media: " << media << endl;

    return 0;
}


#include <iostream>
#include <cmath> // Para usar pow() y M_PI (o constante PI)

using namespace std;

int main() {
    double radio;
    const double PI = 3.14159265358979323846;

    // Leer radio
    cout << "Ingrese el radio de la esfera: ";
    cin >> radio;

    // ¿radio <= 0?
    if (radio <= 0) {
        // Mostrar error -> Fin
        cout << "error: radio debe ser positivo" << endl;
        return 0;
    }

    // Calculo del area y volumen
    double area = 4 * PI * pow(radio, 2);
    double volumen = (4.0 / 3.0) * PI * pow(radio, 3);

    // Mostrar area, volumen -> Fin
    cout << "Area: " << area << endl;
    cout << "Volumen: " << volumen << endl;

    return 0;
}


#include <iostream>

using namespace std;

int main() {
    // num = 100
    int num = 100;

    // ¿num <= 999?
    while (num <= 999) {
        // Descomposición en dígitos
        int c = num / 100;          // c = num div 100
        int d = (num / 10) % 10;    // d = (num div 10) mod 10
        int u = num % 10;           // u = num mod 10

        // ¿c^3 + d^3 + u^3 = num?
        if ((c * c * c) + (d * d * d) + (u * u * u) == num) {
            // Escribir num
            cout << num << endl;
        }

        // num = num + 1
        num = num + 1;
    }

    return 0;
}


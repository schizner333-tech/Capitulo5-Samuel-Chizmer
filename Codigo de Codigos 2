#include <iostream>

using namespace std;

int main() {
    int n;

    // Leer n
    cout << "Ingrese un numero entero n: ";
    cin >> n;

    // ¿n <= 0?
    if (n <= 0) {
        // Mostrar error -> Fin
        cout << "Error: El numero n debe ser mayor a 0." << endl;
        return 0;
    }

    // Suma = 0, i = 1
    int suma = 0;
    int i = 1;

    // ¿i <= n?
    while (i <= n) {
        suma = suma + i; // Suma = Suma + i
        i = i + 1;       // i = i + 1
    }

    // Mostrar suma -> Fin
    cout << "La suma es: " << suma << endl;

    return 0;
}


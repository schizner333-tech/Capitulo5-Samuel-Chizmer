#include <iostream>

using namespace std;

int main() {
    int n;

    // Leer n
    cout << "Ingrese el numero de terminos (n): ";
    cin >> n;

    // suma = 0, i = 1
    double suma = 0.0;
    int i = 1;

    // ¿i <= n?
    while (i <= n) {
        // suma = suma + 1 / (i * i)
        // Se utiliza 1.0 para asegurar la division con decimales (flotante)
        suma = suma + 1.0 / (i * i);
        
        // i = i + 1
        i = i + 1;
    }

    // escribir suma -> Fin
    cout << "La suma resultante es: " << suma << endl;

    return 0;
}


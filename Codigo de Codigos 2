#include <iostream>

using namespace std;

int main() {
    int tope;

    // Leer tope
    cout << "Ingrese el numero limite (tope): ";
    cin >> tope;

    // n = 2
    int n = 2;

    // ¿n <= tope?
    while (n <= tope) {
        // suma = 0, d = 1
        int suma = 0;
        int d = 1;

        // ¿d <= n div 2?
        while (d <= n / 2) {
            // ¿n mod d = 0?
            if (n % d == 0) {
                suma = suma + d; // suma = suma + d
            }
            d = d + 1;           // d = d + 1
        }

        // ¿suma = n?
        if (suma == n) {
            // Escribir n
            cout << "Numero perfecto: " << n << endl;
        }

        // n = n + 1
        n = n + 1;
    }

    return 0;
}


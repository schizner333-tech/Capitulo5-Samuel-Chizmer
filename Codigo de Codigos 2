#include <iostream>

using namespace std;

int main() {
    int n;

    // Leer n
    cout << "Ingrese un numero entero (n): ";
    cin >> n;

    // primo = verdadero, i = 2
    bool primo = true;
    int i = 2;

    // ¿n < 2?
    if (n < 2) {
        primo = false;
    } else {
        // ¿i <= n / 2?
        while (i <= n / 2 && primo) {
            // ¿n mod i = 0?
            if (n % i == 0) {
                primo = false;
            } else {
                i = i + 1;
            }
        }
    }

    // ¿primo?
    if (primo) {
        cout << n << " es primo" << endl;
    } else {
        cout << n << " no es primo" << endl;
    }

    return 0;
}


#include <iostream>

using namespace std;

int main() {
    // Pos=0, neg=0, ceros=0, C=1
    int pos = 0;
    int neg = 0;
    int ceros = 0;
    int C = 1;
    int num;

    // ¿C <= 10?
    while (C <= 10) {
        // Leer num
        cout << "Ingrese el numero (" << C << " de 10): ";
        cin >> num;

        // ¿num > 0?
        if (num > 0) {
            pos = pos + 1;
        } 
        // ¿num < 0?
        else if (num < 0) {
            neg = neg + 1;
        } 
        // No es ni positivo ni negativo -> Ceros
        else {
            ceros = ceros + 1;
        }

        // C = C + 1
        C = C + 1;
    }

    // Mostrar pos, neg, ceros -> Fin
    cout << "\n--- Resultado ---" << endl;
    cout << "Cantidad de positivos: " << pos << endl;
    cout << "Cantidad de negativos: " << neg << endl;
    cout << "Cantidad de ceros: " << ceros << endl;

    return 0;
}


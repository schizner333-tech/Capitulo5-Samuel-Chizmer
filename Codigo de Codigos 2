#include <iostream>

using namespace std;

int main() {
    int num;

    // Leer num
    cout << "Ingrese un numero entero positivo: ";
    cin >> num;

    // ¿num <= 0?
    if (num <= 0) {
        // Mostrar error -> Fin
        cout << "Error: El numero debe ser mayor a 0." << endl;
        return 0;
    }

    // invertido = 0
    int invertido = 0;

    // ¿num > 0?
    while (num > 0) {
        int resto = num % 10;                  // resto = num mod 10
        invertido = (invertido * 10) + resto;  // invertido = (invertido * 10) + resto
        num = num / 10;                        // num = num div 10
    }

    // Mostrar invertido -> Fin
    cout << "Numero invertido: " << invertido << endl;

    return 0;
}

